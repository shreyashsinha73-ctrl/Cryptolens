# CryptoLens IPsec Testbed Container
# Ubuntu 22.04 LTS with strongSwan, Linux netns support, tshark/tcpdump, and Python tooling

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:${PATH}"

# Install core packages, strongSwan, swanctl, network utilities, and packet tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    strongswan \
    strongswan-swanctl \
    libcharon-extra-plugins \
    libstrongswan-extra-plugins \
    libstrongswan-standard-plugins \
    iproute2 \
    iptables \
    iputils-ping \
    tcpdump \
    tshark \
    python3 \
    python3-pip \
    python3-setuptools \
    curl \
    net-tools \
    procps \
    ca-certificates \
    libcap2-bin \
    bsdextrautils \
    && rm -rf /var/lib/apt/lists/*

# Install python dependencies for templating, packet injection, and traffic generation
RUN pip3 install --no-cache-dir \
    jinja2 \
    pyyaml \
    scapy \
    requests

# Create working directory and mount points
WORKDIR /workspace

# Set default entrypoint/command
CMD ["/bin/bash"]
