# ==============================================================================
# CryptoLens Environment Variables
# ==============================================================================

# Google Gemini API key for Data-Plane AI mode & traffic classification
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model name (default: gemini-1.5-flash or gemini-2.0-flash)
GEMINI_MODEL=gemini-1.5-flash

# Inference backend: "llm" (Gemini Cloud API) or "cnn" (Local ONNX model)
CLASSIFIER_BACKEND=llm

# Analyzer mode: "real" (live parsing & ML pipeline) or "mock" (offline sample JSON)
ANALYZER_MODE=real
