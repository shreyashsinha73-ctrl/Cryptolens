# Gemini API Key for Data-Plane LLM classifier stand-in
GEMINI_API_KEY=your_gemini_api_key_here

# Backend selection: "llm" (default MVP stand-in) or "cnn" (intended production path)
CLASSIFIER_BACKEND=llm

# Optional: Gemini model override (default: gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash

# Optional: HTTP request timeout in seconds (default: 10.0)
GEMINI_TIMEOUT_SECONDS=10.0
