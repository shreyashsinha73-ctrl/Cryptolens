{
  "_metadata": {
    "description": "Deterministic baseline audit expectations for testbed captures config_01 through config_06.",
    "derivation_rule": "Scores are derived from compliance_map.yaml weights (enc=25, int=15, kex=15, pfs=10, replay=10, life=10, ike=10, mode=5). Without sidecar, only wire-observable controls (ike_version=10, key_exchange=15/10/0, replay_protection=10) contribute to verified score (3/8 verified controls), with the 5 unobserved/inferred controls (encryption, integrity, pfs, key_lifetime, mode; sum max=65) yielding worst-to-best range and UNVERIFIED risk. With honest sidecar, all 8 controls are verified, yielding full coverage 8/8 and risk label stamped with '(operator-attested)'. NIST SP 800-77r1 and NSA CNSA 2.0 statuses are evaluated per standard control rules in compliance_standards.yaml."
  },
  "config_01": {
    "filename": "config_01_tunnel_aes256gcm_dh19_pfson_all.pcap",
    "ground_truth": {
      "mode": "Tunnel",
      "encryption": "AES-256-GCM",
      "integrity": "AEAD",
      "dh_group": 19,
      "pfs": true,
      "ike_version": "IKEv2",
      "replay_protection": true,
      "key_lifetime_seconds": 28800
    },
    "no_sidecar": {
      "coverage": "3/8",
      "score_range": [35.0, 100.0],
      "risk_label": "UNVERIFIED",
      "expected_findings_ids": [
        "NOT_OBSERVED_ENCRYPTION",
        "NOT_OBSERVED_INTEGRITY",
        "NOT_OBSERVED_PFS",
        "UNKNOWN_KEY_LIFETIME"
      ]
    },
    "with_sidecar": {
      "coverage": "8/8",
      "score_range": [100.0, 100.0],
      "risk_label": "LOW (operator-attested)",
      "expected_findings_ids": []
    },
    "standards_compliance": {
      "dh_group": {
        "NIST_SP_800_77_R1": "ALIGNED",
        "CNSA_2_0": "FAIL"
      },
      "encryption": {
        "NIST_SP_800_77_R1": "ALIGNED",
        "CNSA_2_0": "ALIGNED"
      }
    }
  },
